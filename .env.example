# 실행할 이미지 태그입니다. 비워두면 compose 파일이 이 릴리즈의 태그를 씁니다 —
# 오프라인 아카이브를 `docker load`하면 그 이름으로 올라오므로 그대로 두면 됩니다.
# 다른 버전으로 되돌릴 때만 지정하세요.
# RESSO_VERSION=v0.9.21

POSTGRES_DSN=postgres://resso:change-me@postgres.example.internal:5432/resso?sslmode=require
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# 신규 설치 권장: 두 값을 각각 `openssl rand -base64 32` 결과로 교체하세요.
DATA_ENCRYPTION_KEYS=data-primary:replace-with-a-random-32-byte-base64-key
DIGEST_KEYS=digest-primary:replace-with-a-different-random-32-byte-base64-key
# v0.2.0 업그레이드 호환용입니다. 전환 중에만 주석을 풀고 기존 값을 유지하세요.
# ENCRYPTION_KEY=replace-with-the-existing-v0.2.0-key
TRUSTED_PROXY_CIDRS=

# 선택. 호스트에서 열어둘 포트입니다. 컨테이너 안에서는 항상 :8080에 바인딩합니다 —
# 그래야 게시 포트와 Health Check가 따로 맞춰야 할 두 값이 되지 않습니다.
# 바인딩 주소 자체를 바꾸는 LISTEN_ADDRESS는 바이너리를 직접 실행할 때 쓰는 설정입니다.
# PUBLISHED_PORT=8080
